# Copy to `.env.local` and fill in (Next.js loads `.env.local` in dev — do not commit secrets).
# Same variable names as Vercel → Project → Settings → Environment Variables.
#
# Supabase: Dashboard → Connect → "Shared Pooler" URI.
# Replace placeholders with your project values and password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

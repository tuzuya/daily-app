# Neon の **pooled** 接続文字列（ホスト名に -pooler が入っているもの）
# direct のほうを使うとサーバーレスで接続を使い切る
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# 公開URL。OG画像などの相対URL解決に使う（任意）
# NEXT_PUBLIC_SITE_URL="https://<your-app>.vercel.app"

# 暫定の Basic 認証（src/proxy.ts）。本番では両方必須。未設定だと全リクエストが 503 になる
# Vercel では Production と Preview の両方に設定すること
BASIC_AUTH_USER="<user>"
BASIC_AUTH_PASSWORD="<long-random-password>"
